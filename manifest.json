{
  "manifest_version": 3,
  "name": "Filmaffinity extendido",
  "version": "0.1.0",
  "description": "Advanced filters and extra info (e.g. streaming platforms) for FilmAffinity lists.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.filmaffinity.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "exclude_globs": [
        "*FASID*",
        "*/sharerating*",
        "*/userratings*",
        "*/userrating*",
        "*/names-together*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
