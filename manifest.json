{
  "manifest_version": 3,
  "name": "Filmaffinity extendido",
  "version": "1.0.0",
  "description": "Filtros avanzados e información extra (como las plataformas de streaming) para tus listas de Filmaffinity.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.filmaffinity.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "exclude_globs": [
        "*FASID*",
        "*/sharerating*",
        "*/userratings*",
        "*/userrating*",
        "*/names-together*",
        "*/main.html"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
